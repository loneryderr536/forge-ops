{
  "name": "groundwork",
  "displayName": "Groundwork",
  "description": "Evidence-based, reviewed VS Code coding agent client for TrueForge.",
  "version": "0.1.0",
  "publisher": "groundwork-team",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:groundwork.panel",
    "onCommand:groundwork.inlineEdit",
    "onCommand:groundwork.newTask"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "groundwork",
          "title": "Groundwork",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "groundwork": [
        {
          "type": "webview",
          "id": "groundwork.panel",
          "name": "Groundwork Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "groundwork.newTask",
        "title": "Groundwork: New Task"
      },
      {
        "command": "groundwork.inlineEdit",
        "title": "Groundwork: Inline Edit"
      },
      {
        "command": "groundwork.stop",
        "title": "Groundwork: Stop Run"
      },
      {
        "command": "groundwork.undoRun",
        "title": "Groundwork: Undo Last Run"
      },
      {
        "command": "groundwork.selectModel",
        "title": "Groundwork: Select Model"
      },
      {
        "command": "groundwork.showSession",
        "title": "Groundwork: Show TrueForge Session"
      },
      {
        "command": "groundwork.ping",
        "title": "Groundwork: Ping TrueForge"
      }
    ],
    "keybindings": [
      {
        "command": "groundwork.inlineEdit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Groundwork",
      "properties": {
        "groundwork.trueforgeUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Base URL for the local TrueForge agent server."
        },
        "groundwork.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "google-gemini/gemini-2-5-flash",
            "groq/llama-3-3-70b-versatile",
            "ollama/qwen2-5-coder-7b"
          ],
          "description": "Configured models list (primary first, followed by fallback options)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import ../scripts/register-loader.mjs --test test/smoke.test.ts test/mcp/*.test.ts test/edits/*.test.ts test/stats/*.test.ts test/trueforge/*.test.ts test/context/*.test.ts"
  },
  "dependencies": {
    "diff": "^7.0.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
